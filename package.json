{
  "name": "fhir-mcp",
  "version": "1.0.0",
  "description": "FHIR-MCP server for FHIR and HL7 terminology services",
  "private": true,
  "workspaces": [
    "packages/*",
    "packages/examples/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces",
    "test": "npm run test --workspaces",
    "lint": "eslint packages/**/*.ts",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@typescript-eslint/eslint-plugin": "^6.21.0",
    "@typescript-eslint/parser": "^6.21.0",
    "eslint": "^8.0.0",
    "typescript": "^5.0.0"
  },
  "engines": {
    "node": ">=18"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/yourusername/FHIR-MCP.git"
  },
  "keywords": [
    "fhir",
    "mcp",
    "healthcare",
    "interoperability",
    "llm"
  ]
}
