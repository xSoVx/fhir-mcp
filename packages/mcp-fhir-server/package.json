{
  "name": "@fhir-mcp/server",
  "version": "1.0.0",
  "description": "FHIR-MCP server for FHIR operations",
  "main": "dist/index.js",
  "type": "module",
  "bin": {
    "fhir-mcp": "dist/index.js"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "start": "node dist/index.js",
    "start:http": "MCP_TRANSPORT=http PORT=8080 node dist/http.js",
    "test": "node ./scripts/run-jest.mjs",
    "test:watch": "node ./scripts/run-jest.mjs --watch",
    "test:coverage": "node ./scripts/run-jest.mjs --coverage",
    "test:gate": "node ./scripts/check-test-baseline.mjs",
    "golden:update": "node ./scripts/update-golden.mjs",
    "test:http": "node src/test-http-integration.js",
    "lint": "eslint src --ext .ts",
    "typecheck": "tsc --noEmit",
    "typecheck:tests": "tsc --noEmit -p tsconfig.test.json"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^0.5.0",
    "axios": "^1.6.0",
    "zod": "^3.22.0",
    "joi": "^17.11.0",
    "isomorphic-dompurify": "^2.6.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "typescript": "^5.0.0",
    "@jest/globals": "^29.7.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.0",
    "eslint": "^8.57.0",
    "@typescript-eslint/eslint-plugin": "^6.19.0",
    "@typescript-eslint/parser": "^6.19.0"
  },
  "files": [
    "dist/**/*"
  ]
}